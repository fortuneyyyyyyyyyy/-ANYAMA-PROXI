# Générer une vraie valeur aléatoire : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-with-a-long-random-secret
# Copier l'URL pooled de Neon, idéalement avec ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
FLASK_ENV=development
FLASK_DEBUG=1
COOKIE_SECURE=0
